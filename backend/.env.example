# Copy to .env and fill in. Never commit .env.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy (503) or out of quota (429)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash

# Optional backup for the report when every Gemini model is down (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tiger Data / Tiger Cloud connection string (postgres://...)
# Leave blank to run without the database (price check and failure curves will be empty).
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# true = serve the three demo cars from demo_cache/ first (survives bad Wi-Fi)
DEMO_MODE=true
